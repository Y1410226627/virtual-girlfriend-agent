# ===== 大模型接口（OpenAI 兼容格式）=====
# 任何支持 OpenAI 协议的服务都可以：vLLM / Ollama / DeepSeek / 通义千问 / OpenAI ...
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=你的APIKEY
LLM_MODEL=qwen3.8-27b

# 后台分析模型：建议用一个"快"的模型（分析在后台跑，越快越无感）
LLM_ANALYSIS_MODEL=deepseek-v4-flash-0731-w8a8

EMBEDDING_MODEL=qwen3-vl-embedding-8b

ANALYSIS_THINKING=false

# DB_PATH=data/girlfriend.db