{
  "name": "virtual-girlfriend-agent",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "set NEXT_TELEMETRY_DISABLED=1&& next dev -p 3000 -H 127.0.0.1",
    "build": "set NEXT_TELEMETRY_DISABLED=1&& next build",
    "start": "set NEXT_TELEMETRY_DISABLED=1&& next start -p 3000 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/node-ts-resolver.mjs --test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:cycles && npm run check:migrations && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "globals": "^15.15.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  }
}
