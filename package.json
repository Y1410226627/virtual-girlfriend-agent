{
  "name": "virtual-girlfriend-agent",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "set NEXT_TELEMETRY_DISABLED=1&& next dev -p 3000",
    "build": "set NEXT_TELEMETRY_DISABLED=1&& next build",
    "start": "set NEXT_TELEMETRY_DISABLED=1&& next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/node-ts-resolver.mjs --test",
    "verify": "npm run typecheck && npm run test && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0"
  }
}